#################################
###### App Config ###############
#################################
APP_NAME="SupportAgent"
APP_VERSION="0.1.0"
MODE="production"
LOG_LEVEL="INFO"
# In production the app refuses to start on wildcard ALLOWED_HOST/ORIGINS or enabled docs.
# Set STRICT_PRODUCTION_CHECKS="false" to downgrade these to warnings.
# STRICT_PRODUCTION_CHECKS="true"
SUMMARY="SupportAgent Backend"

#################################
###### CORS Config ##############
#################################
# Replace the placeholders with your real frontend origin(s) and hostname(s)
# (comma-separated). Production refuses to start on "*".
ORIGINS="https://your-app.example.com"
ALLOWED_HOST="your-app.example.com"

#################################
###### Paths ####################
#################################
ROOT_PATH="/"
# API docs (and /openapi.json) are served only when a path is set. Keep them off in
# production; set e.g. DOCS_PATH="/docs" for a staging deployment.
DOCS_PATH=""
REDOCS_PATH=""

#################################
###### Request Limits ###########
#################################
MAX_REQUEST_SIZE=10485760  # 10MB

#################################
###### Security Headers #########
#################################
SECURITY_HEADERS_ENABLED="true"
HSTS_ENABLED="true"
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS="true"
HSTS_PRELOAD="false"
FRAME_OPTIONS="DENY"
CONTENT_TYPE_OPTIONS="nosniff"
XSS_PROTECTION="1; mode=block"
REFERRER_POLICY="strict-origin-when-cross-origin"

#################################
###### Snowflake ID Config ######
#################################
SNOWFLAKE_EPOCH=1609459200000
SNOWFLAKE_NODE_ID=1
SNOWFLAKE_WORKER_ID=2

#################################
###### Sentry Config ############
#################################
SENTRY_DSN=""

#################################
###### Postgres Config ##########
#################################
# Durable thread state, plus the long-term memory store when enabled. Local example value;
# replace it in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent"

#################################
###### Redis Config #############
#################################
# Hot thread cache for the Postgres checkpointer and the API's cache store (rate limiting,
# run locks and caps, token revocation), plus background task status and results. Local example value; replace it in production.
REDIS_URL="redis://localhost:6379/0"

#################################
###### Broker Config ############
#################################
# Message broker for background tasks. Local example value; replace it in production.
BROKER_URL="amqp://guest:guest@localhost:5672/"

#################################
###### JWT Config ###############
#################################
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"

#################################
###### API Keys #################
#################################
GOOGLE_API_KEY=""

#################################
###### OpenTelemetry ############
#################################
OTEL_ENABLED="true"
OTEL_SERVICE_NAME="support-agent"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
