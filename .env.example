#################################
###### App Config ###############
#################################
APP_NAME="SupportAgent"
APP_VERSION="0.1.0"
MODE="production"
LOG_LEVEL="INFO"
# In production the app refuses to start on wildcard ALLOWED_HOST/ORIGINS or enabled docs.
# Set STRICT_PRODUCTION_CHECKS="false" to downgrade these to warnings.
# STRICT_PRODUCTION_CHECKS="true"
SUMMARY="SupportAgent Backend"

#################################
###### CORS Config ##############
#################################
# Frontend origin(s) and hostname(s), comma-separated. Production refuses to start on "*".
# Local values: the hosted playground talking to http://localhost:8000. ALLOWED_HOST keeps
# 127.0.0.1 for the container health check.
ORIGINS="https://play.10xgraph.com"
ALLOWED_HOST="localhost,127.0.0.1"

#################################
###### Paths ####################
#################################
ROOT_PATH="/"
# API docs (and /openapi.json) are served only when a path is set. Keep them off in
# production; set e.g. DOCS_PATH="/docs" for a staging deployment.
DOCS_PATH=""
REDOCS_PATH=""

#################################
###### Request Limits ###########
#################################
MAX_REQUEST_SIZE=10485760  # 10MB

#################################
###### Security Headers #########
#################################
SECURITY_HEADERS_ENABLED="true"
HSTS_ENABLED="true"
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS="true"
HSTS_PRELOAD="false"
FRAME_OPTIONS="DENY"
CONTENT_TYPE_OPTIONS="nosniff"
XSS_PROTECTION="1; mode=block"
REFERRER_POLICY="strict-origin-when-cross-origin"

#################################
###### Snowflake ID Config ######
#################################
SNOWFLAKE_EPOCH=1609459200000
SNOWFLAKE_NODE_ID=1
SNOWFLAKE_WORKER_ID=2

#################################
###### Sentry Config ############
#################################
SENTRY_DSN=""

#################################
###### Postgres Config ##########
#################################
# docker-compose.yml creates user and database "tenxgraph" with POSTGRES_PASSWORD and builds
# the containers' own URLs from it. The URLs in this file are for scripts and evals run on the
# host (published ports), so use the same passwords in them. Keep passwords URL-safe.
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://tenxgraph:change-me@127.0.0.1:5433/tenxgraph"

#################################
###### Redis Config #############
#################################
# Hot thread cache for the Postgres checkpointer and the API's cache store (rate limiting,
# run locks and caps, token revocation), plus background task status and results. Local example value; replace it in production.
REDIS_URL="redis://127.0.0.1:6380/0"

#################################
###### Broker Config ############
#################################
# Graph events and background tasks. User "tenxgraph"; there is no guest user.
RABBITMQ_PASSWORD="change-me"
BROKER_URL="amqp://tenxgraph:change-me@127.0.0.1:5672/"

#################################
###### JWT Config ###############
#################################
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"

#################################
###### API Keys #################
#################################
GOOGLE_API_KEY=""

#################################
###### OpenTelemetry ############
#################################
# Metrics ("metrics" in 10xgraph.json) are pushed to Prometheus's OTLP receiver, which takes
# metrics only. AI traces go to Phoenix ("observability"). Keep OTEL_ENABLED off: it also sends
# request traces over gRPC to OTEL_EXPORTER_OTLP_ENDPOINT, which Prometheus rejects.
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="support-agent"
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://127.0.0.1:9090/api/v1/otlp/v1/metrics"

#################################
###### Grafana ##################
#################################
# Login "admin" at http://127.0.0.1:3001.
GRAFANA_ADMIN_PASSWORD="change-me"

#################################
###### pgAdmin ##################
#################################
# http://127.0.0.1:5050, login PGADMIN_EMAIL / PGADMIN_PASSWORD.
PGADMIN_EMAIL="admin@example.com"
PGADMIN_PASSWORD="change-me"

#################################
###### Phoenix (AI traces) ######
#################################
# "observability.phoenix" in 10xgraph.json; project support-desk.
PHOENIX_COLLECTOR_ENDPOINT="http://127.0.0.1:6006"

#################################
###### demo_server ##############
#################################
# MCP endpoint the support agent's tools come from.
DEMO_MCP_URL="http://127.0.0.1:8100/mcp/"
