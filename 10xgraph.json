{
  "agent": "graph.agent:app",
  "env": ".env",
  "auth": {
    "method": "jwt"
  },
  "thread_name_generator": "graph.thread_name_generator:MyNameGenerator",
  "ag_ui": {
    "enabled": false,
    "allow_client_tools": false
  },
  "websocket": {
    "enabled": false
  },
  "remote_tools": [],
  "injectq": "graph.agent:container",
  "store": "graph.agent:store",
  "id_generator": "uuid",
  "cache_store": {
    "type": "redis",
    "rate_limit": {
      "enabled": true,
      "requests": 100,
      "window": 60,
      "by": "user",
      "trusted_proxy_headers": false,
      "fail_open": false,
      "exclude_paths": [
        "/ping",
        "/docs",
        "/redocs",
        "/openapi.json"
      ]
    },
    "token_revocation": true
  },
  "audit": {
    "enabled": true,
    "sinks": [
      "log"
    ],
    "include_reads": true
  },
  "worker": {
    "broker": {
      "type": "rabbitmq",
      "url": "${BROKER_URL}"
    },
    "tasks": [
      "worker.tasks"
    ]
  },
  "test": {
    "path": "tests",
    "coverage": true,
    "coverage_threshold": 70
  },
  "evaluation": {
    "directory": "evals",
    "output_dir": "eval_reports",
    "threshold": 0.75,
    "parallel": false,
    "max_concurrency": 4,
    "timestamp_files": true
  }
}
